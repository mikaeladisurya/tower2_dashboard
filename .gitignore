# ============================================================
#  tower2_dashboard — project-wide gitignore
# ============================================================

# ---- Data sensitif / internal PLN — JANGAN commit ----
# DAPEG & sampel asli berisi PII (nama, NIP, KTP, email pegawai).
# Catatan: file2 ini SUDAH terlanjur masuk history git (lihat catatan tim);
# di-untrack dari sini agar tidak ikut commit berikutnya.
data sintetis/

# Bahan referensi mentah: PDF perdir/SK berukuran besar + screenshot
# yang memuat nama pegawai. Hasil sulingannya masuk ke knowledge/ (yang di-track).
referensi/

# ---- Setting lokal editor & agen (mesin-spesifik) ----
.claude/
.agents/
.vscode/
skills-lock.json
CLAUDE.md
recruitment_dashboardv3/docs/REBUILD_WIREFRAME.md

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# ---- Streamlit / app runtime ----
# **/ supaya cocok di semua subproyek (recruitment_dashboard/, recruitment_dashboardv2/,
# dst) -- pola tanpa **/ hanya cocok di root repo karena mengandung slash di tengah.
**/.streamlit/secrets.toml
*.db
*.sqlite
*.sqlite3

# ---- File kerja Excel (lock) ----
~$*.xls
~$*.xlsx

# ---- Scratch / sementara ----
*.tmp
*.log
chatbotv1.py

# ---- OS ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Knowledge base: material MENTAH riset (lokal saja) ----
# Yang di-track: findings.md, RESEARCH_PLAN.md, build/ (skrip), + katalog program publik
# (programs.csv/json, profesi.csv). Sisanya di bawah ini bulky/sensitif/regenerable → lokal.
knowledge/sources/**/raw/
knowledge/sources/rekrutmen_pln/pdf/
knowledge/sources/perdir/
knowledge/sources/htd_chat/
# Area akun: blokir SEMUA dump (html/png berisi PII pihak ketiga),
# kecuali skema_form.md yang sudah disensor & memang jadi acuan desain tabel.
knowledge/sources/rekrutmen_pln/akun/*
!knowledge/sources/rekrutmen_pln/akun/skema_form.md
# Profil browser (menyimpan cookie sesi login) — jangan pernah di-commit.
knowledge/sources/rekrutmen_pln/.browser_profile/
# PDF laporan resmi PLN (publik tapi besar & bisa diunduh ulang kapan saja).
knowledge/sources/laporan_pln/pdf/

knowledge/sources/rbb_fhci/raw_*.json

# ---- mockdb: keluaran generator (besar & bisa dibangkitkan ulang dari rules/) ----
mockdb/out/*.duckdb
mockdb/out/csv/
mockdb/out/parquet/
# Bahan kerja eksplorasi manual: notebook ad-hoc (menyimpan keluaran sel berisi
# cuplikan baris) + salinan skema ke Excel. Keduanya bisa dibuat ulang kapan saja.
mockdb/eksplorasi_rekrutmen.ipynb
mockdb/mockdb schema.xlsx
# out/master/*.csv: blokir semua, lalu buka lagi 7 berkas FONDASI (langkah 01/02) yang
# TIDAK bisa dibangkitkan ulang tanpa akses DAPEG asli (data sintetis/, di-gitignore di
# atas) -- keduanya kecil (<2,2 MB) dan aman di-track (agregat, bukan baris per-orang).
# Sisanya (langkah 03-12: kandidat/pendaftaran/seleksi/pasca/penempatan/dst) 100%
# regenerable dari fondasi + rules/ + knowledge/sources/ + seed tunggal (kohort.yaml),
# jadi tidak perlu ikut repo -- sudah menembus 90+ MB per berkas (F-083).
mockdb/out/master/*.csv
!mockdb/out/master/unit_induk.csv
!mockdb/out/master/unit_pelaksana.csv
!mockdb/out/master/realisasi_bulanan.csv
!mockdb/out/master/jabatan_katalog.csv
!mockdb/out/master/jabatan_klasifikasi.csv
!mockdb/out/master/posisi_unit_induk.csv
!mockdb/out/master/posisi_unit_pelaksana.csv
