# Copy this file to .streamlit/secrets.toml and fill in your own credentials.
# secrets.toml itself is gitignored, so your keys never get committed.
#
# Any OpenAI-compatible endpoint works. Add or remove [llm.*] blocks freely - each
# one shows up as a selectable model in the Recruitment Copilot sidebar. The block
# name after "llm." (e.g. "openai" below) is just an internal id, it can be anything.
#
# If you don't add any [llm.*] block, the app falls back to the demo mode (only the
# rule-based "local answer" path works, no LLM/SQL features).

[llm.openai]
label = "GPT-5.6 Luna (OpenAI)"
icon = "🟢"
api_key = "sk-YOUR_OPENAI_API_KEY"
base_url = "https://api.openai.com/v1"
model = "gpt-5.6-luna"

[llm.llama4]
label = "Llama 4 Scout"
icon = "🦙"
api_key = "YOUR_API_KEY"
base_url = "https://your-provider.example.com/v1"
model = "meta-llama/llama-4-scout"

# Optional: a short note shown under the status badge, e.g. for a free/expiring key.
# note = "Free API key - expires 2026-08-12"
